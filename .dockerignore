# Keep the build context small and platform-clean.
node_modules
**/node_modules
web/dist
.git

# The Android project is a separate build (android/docker/) and its synced
# assets are megabytes of minified bundles.
android

# Bench corpus snapshot: 17 MB of another repo's source.
bench/corpus.json
extract/graph.extracted.json

# Generated layout artifacts — the image regenerates them from the committed
# canonical graphs, so shipping the host's copies in would only risk staleness.
web/public/data

# Never let signing material near a build context.
**/keystore
**/keystore.properties

*.png
*.apk

node_modules/
dist/
.env

# Raw extractor output: large and regenerable in seconds. The canonical
# graph beside it IS committed — it's small and portable.
data/*/graph.json

# Generated by `npm run build:graph` — all regenerable from the committed
# canonical graph in seconds.
web/public/data/*.layout.json
web/public/data/*.edges.json
web/public/data/*.sources.json
web/public/data/*/src/

# Source text captured at extraction, for the code viewer. Another project's
# source; large (Aeon's is 18 MB) and regenerable by re-running the extractor.
data/*/sources.json

# Verification screenshots, written by the drive into web/ and by ad-hoc runs
# at the repo root.
#
# Scoped by LOCATION, never a blanket `*.png`. A global rule silently swallowed
# all 26 Android resource PNGs — every launcher icon and every splash density —
# and because they existed on disk locally, every local build passed. It failed
# only in CI, where a fresh checkout genuinely lacked them:
#   error: resource drawable/splash (aka app.grapheon:drawable/splash) not found
# Anything nested (android/**/res, docs/) is tracked.
/*.png
/web/*.png
!/86.png

# Bench corpus snapshot: 17 MB of another repo's source, regenerated by
# pack-corpus.mjs.
bench/corpus.json

# Scoring output of the JS extractor over the bench corpus; regenerate with
# node extract/node.mjs <repo>.
extract/graph.extracted.json

# Capacitor syncs the BUILT web app into the android project — pure build
# artifact, recreated by `npx cap sync android`. (The android/ project itself
# IS committed; it's source.)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# Release signing material. NEVER commit a keystore or its passwords; losing
# them means losing the app identity, leaking them means losing the app.
android/keystore/
android/keystore.properties

# Drive output: the exported map, written next to the screenshots.
exported-map.html
